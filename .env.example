# Copy to .env.local at the repository root. Never commit secrets.
# demo explicitly simulates payments and verification. sandbox uses real sandbox APIs.
REVISIONPAY_MODE=demo
APP_URL=http://localhost:3000
MONGODB_URI=
MONGODB_DATABASE=revisionpay
# Local demo only; Vercel always requires MongoDB.
LOCAL_DATA_PATH=.local/revisionpay.json
AUTH_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
SELLER_GITHUB_ID=
CRON_SECRET=
SETTLEMENT_PAUSED=false
NEW_JOBS_PAUSED=false
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_MERCHANT_ID=
# Studionet is the selected GenLayer environment.
GENLAYER_RPC_URL=https://studio.genlayer.com/api
GENLAYER_CHAIN_ID=61999
GENLAYER_PRIVATE_KEY=
CAPTURE_SERVICE_URL=http://localhost:3001
CAPTURE_SECRET=
# Capture service uses this file locally; in Vercel configure only its own secrets.
CAPTURE_ALLOWED_HOSTS=
# Never enable this for an internet-facing deployment.
CAPTURE_ALLOW_LOCALHOST=true
MAX_ACTIVE_AGREEMENTS=10
MAX_DAILY_VERIFICATIONS=20

# Email sign-in and client updates. Verify an OWNED sender domain in Resend.
# A shared *.vercel.app or *.netlify.app address cannot be a sender domain.
RESEND_API_KEY=
MAIL_FROM=
# Connected marketplace sandbox testing uses a PayPal Platform REST app.
PAYPAL_PLATFORM_CLIENT_ID=
PAYPAL_PLATFORM_CLIENT_SECRET=
PAYPAL_PLATFORM_WEBHOOK_ID=
PAYPAL_PARTNER_ID=
PAYPAL_PARTNER_ATTRIBUTION_ID=
# Live credentials must stay separate from sandbox credentials.
PAYPAL_LIVE_CLIENT_ID=
PAYPAL_LIVE_CLIENT_SECRET=
PAYPAL_LIVE_PARTNER_ID=
PAYPAL_LIVE_WEBHOOK_ID=
PAYPAL_PARTNER_APPROVED=false
LIVE_PAYMENT_VALIDATED=false
LIVE_PAYMENTS_ENABLED=false
# New live agreements are capped at 10/month, 5 active globally, 2 per seller.
# Leave CAPTURE_ALLOWED_HOSTS empty for automatic public HTTPS page validation.
# Primary sign-in: Google OAuth Web application (basic profile/email scopes).
# Redirect URI: APP_URL/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
