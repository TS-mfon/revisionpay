# Copy to .env.local at the repository root. Never commit secrets.
# demo explicitly simulates payments and verification. sandbox uses real sandbox APIs.
REVISIONPAY_MODE=demo
APP_URL=http://localhost:3000
MONGODB_URI=
MONGODB_DATABASE=revisionpay
# Local demo only; Vercel always requires MongoDB.
LOCAL_DATA_PATH=.local/revisionpay.json
AUTH_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
SELLER_GITHUB_ID=
CRON_SECRET=
SETTLEMENT_PAUSED=false
NEW_JOBS_PAUSED=false
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_MERCHANT_ID=
# Studionet is the selected GenLayer environment.
GENLAYER_RPC_URL=https://studio.genlayer.com/api
GENLAYER_CHAIN_ID=61999
GENLAYER_PRIVATE_KEY=
CAPTURE_SERVICE_URL=http://localhost:3001
CAPTURE_SECRET=
# Capture service uses this file locally; in Vercel configure only its own secrets.
CAPTURE_ALLOWED_HOSTS=
# Never enable this for an internet-facing deployment.
CAPTURE_ALLOW_LOCALHOST=true
MAX_ACTIVE_AGREEMENTS=10
MAX_DAILY_VERIFICATIONS=20
